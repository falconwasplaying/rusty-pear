{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Pear Desktop main window",
  "windows": ["*"],
  "remote": {
    "urls": ["https://music.youtube.com/*", "https://*.youtube.com/*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "process:default",
    "global-shortcut:default"
  ]
}
